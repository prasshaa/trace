# Copy to .env and adjust. Never commit .env.
# Local Supabase development database only (from `supabase start`).
# DATABASE_URL is the ADMIN / migration identity: scripts and tests only. Never configure it on an API server.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DATABASE_RUNTIME_URL is the restricted login the API uses (trace_app_runtime). Locally, create it with
#   python -m scripts.provision_runtime_role
# which sets a random password and writes this line for you. The API refuses a privileged login here.
# DATABASE_RUNTIME_URL=postgresql://trace_app_runtime:<generated>@127.0.0.1:54322/postgres
# Seconds to wait when opening a database connection.
DB_CONNECT_TIMEOUT=5
# Local Supabase Auth (from `supabase status`). The anon key is public and is the only key sent to browsers.
# Never put the service-role key or the JWT secret here: the API needs neither.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Optional. Defaults to $SUPABASE_URL/auth/v1; access tokens are verified with ES256 keys from its JWKS endpoint.
# SUPABASE_JWT_ISSUER=
# Local synthetic demo: 1 enables synthetic fixture designation on upload, only against a local database. Default 0.
TRACE_DEMO_FIXTURES=0
# Server-controlled data mode; it alone chooses the reference source. synthetic_demo: synthetic test profiles (local and
# internal QA). production: eligible real contributed profiles only (refuses to start with TRACE_DEMO_FIXTURES=1).
# Anything else fails closed.
TRACE_DATA_MODE=synthetic_demo
# Backend rate limits (in-process, single worker). Rules are "<requests>/<seconds>".
TRACE_RATE_LIMITS_ENABLED=1
# RATE_LIMIT_UPLOAD_USER=5/3600
# RATE_LIMIT_MUTATION_USER=240/60
# RATE_LIMIT_READ_USER=60/60
# Google sign-in is configured in Supabase Auth (data-foundation/supabase/config.toml), never here: the client secret
# is read by the Supabase CLI from SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET in the shell that runs `supabase start`.
# synthetic_demo only: cohorts an explicit ?cohort= may name, for engineering isolation tests. Ignored in production.
TRACE_ENABLED_COHORTS=synthetic
# Shared-contribution consent policy: opt_in (default) or disabled. Anything else fails closed.
TRACE_CONTRIBUTION_POLICY=opt_in
# Interactive API docs (/docs, /redoc, /openapi.json). Off unless set to 1 (local development only).
TRACE_API_DOCS_ENABLED=0
# A user's own resume (POST /api/v1/real-resumes). Off unless set to 1.
TRACE_REAL_RESUME_UPLOADS=0
# Career Origins & Transitions (internal preview, D46). Off by default; never enable for external users until the release gates in docs/CAREER_ORIGINS_GOVERNANCE.md are cleared.
TRACE_CAREER_ORIGINS=0
# Automatic contribution processing (drains the durable queue in the database).
TRACE_CONTRIBUTION_WORKER=1
# Bounded retries of contribution processing errors (attempts 1-20; backoff base * 2^(attempt-1) seconds, capped).
TRACE_CONTRIBUTION_MAX_ATTEMPTS=5
TRACE_CONTRIBUTION_BACKOFF_BASE_SECONDS=30
TRACE_CONTRIBUTION_BACKOFF_MAX_SECONDS=3600
TRACE_CONTRIBUTION_LEASE_SECONDS=120
# AES-256-GCM key for identity markers (32 random bytes, URL-safe base64). From a secret manager; never commit one.
# Without it, real-resume processing is refused. Generate:
#   python -c "from app.services.contributions.sealing import new_key; print(new_key())"
TRACE_IDENTITY_MARKER_KEY=
# The key must stay the same across restarts (markers sealed with a lost key can't be opened). Rotation: move the old key
# here (comma-separated), set a new TRACE_IDENTITY_MARKER_KEY, run `python -m scripts.privacy_maintenance reseal-markers --apply`.
TRACE_IDENTITY_MARKER_PREVIOUS_KEYS=
TRACE_QUEUE_EVENT_RETENTION_DAYS=90
# Demo narrative. Off unless TRACE_AI_ASSESSMENT=1. The key is never committed. OpenAI-compatible POST {BASE_URL}/chat/completions.
# xAI Grok uses the same shape. Do not put a key in this file.
# TRACE_AI_ASSESSMENT=1
# TRACE_LLM_PROVIDER=xai
# TRACE_LLM_BASE_URL=https://api.x.ai/v1
# TRACE_LLM_MODEL=grok-4.7
# TRACE_LLM_API_KEY=
# Seconds. Reasoning models often need more than a minute. Default 120.
# TRACE_LLM_TIMEOUT=120
# Optional. Sent only when set, for example low. Empty uses the provider default.
# TRACE_LLM_REASONING_EFFORT=
# Semantic retrieval for that narrative. Embeddings stay on this machine (gte-small). Both default off.
# TRACE_EMBEDDINGS=1
# TRACE_SEMANTIC_RETRIEVAL=1
